+def _texture_cache_key(texture):
+    """Return a stable key for file-backed and embedded texture images."""
+    if texture.image_path is not None:
+        return ("path", texture.image_path)
+
+    image = np.ascontiguousarray(texture.image_array)
+    return (
+        "embedded",
+        image.shape,
+        image.dtype.str,
+        hashlib.blake2b(image.data, digest_size=16).digest(),
+    )
+
